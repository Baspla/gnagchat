{
  "name": "gnagchat",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "shared"
  ],
  "scripts": {
    "dev:backend": "bun --filter @gnagchat/backend dev",
    "dev:frontend": "bun --filter @gnagchat/frontend dev",
    "dev": "concurrently \"bun run dev:backend\" \"bun run dev:frontend\"",
    "check-port": "npx detect-port 5173",
    "free-port": "npx kill-port 5173",
    "start:backend": "bun --filter @gnagchat/backend start",
    "start:frontend": "bun --filter @gnagchat/frontend start",
    "start": "concurrently \"bun run start:backend\" \"bun run start:frontend\"",
    "db:generate": "bun --filter @gnagchat/backend db:generate",
    "db:migrate": "bun --filter @gnagchat/backend db:migrate",
    "db:studio": "bun --filter @gnagchat/backend db:studio",
    "db:checkpoint": "bun --filter @gnagchat/backend db:checkpoint"
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "concurrently": "^9.2.3"
  },
  "dependencies": {
    "rollup": "^4.62.4",
    "vite": "^8.2.0"
  }
}