# Frontend environment variables
# Public variables (available to client code) must be prefixed with PUBLIC_

PUBLIC_GNAGCHAT_OAUTH_PROVIDER_ID=oauthproviderid
PUBLIC_GNAGCHAT_API_URL=http://localhost:3000
GNAGCHAT_API_URL_INTERNAL=http://localhost:3000/api
PUBLIC_GNAGCHAT_BETTER_AUTH_URL=http://localhost:3000
PUBLIC_GNAGCHAT_LIVEKIT_URL=ws://localhost:7880

# Log level: 'error' | 'warn' | 'info' | 'debug'
# Defaults to 'info' in dev, 'warn' in production
# PUBLIC_GNAGCHAT_LOG_LEVEL=info
